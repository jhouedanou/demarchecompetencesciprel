# =============================================================================
# CIPREL Compétences — Variables d'environnement PRODUCTION
# =============================================================================
# Modèle SANS valeurs (diffusable). Le fichier réel .env.production, pré-rempli,
# est fourni dans le pack de déploiement. Pour recréer un fichier depuis zéro :
#   cp .env.production.example .env.production   puis renseigner les valeurs
#   (clés Supabase : dashboard Supabase > Project Settings > API).
# Ne JAMAIS commiter .env.production (déjà exclu par .gitignore)
# =============================================================================

# --- Supabase (OBLIGATOIRE : authentification + données) --------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Base SQLite / Turso (module progression de lecture) ---------------------
# Laisser vide => base SQLite locale créée dans ./data/ciprel.db
# (le dossier ./data doit être accessible en écriture par l'utilisateur PM2)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Application (OBLIGATOIRE) ----------------------------------------------
NEXT_PUBLIC_APP_URL=https://competences.ciprel.ci
NEXT_PUBLIC_SITE_NAME=CIPREL Compétences
NEXT_PUBLIC_COMPANY_NAME=CIPREL
NEXT_PUBLIC_COMPANY_EMAIL=contact@ciprel.ci
NEXT_PUBLIC_COMPANY_WEBSITE=https://www.ciprel.ci
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_PHONE=

# --- Intégration SharePoint / Teams (iframe) --------------------------------
# true => cookies de session SameSite=None; Secure (requis pour l'affichage
# dans ciprelci.sharepoint.com). HTTPS obligatoire.
NEXT_PUBLIC_ALLOW_IFRAME_EMBED=true

# --- RGPD -------------------------------------------------------------------
NEXT_PUBLIC_GDPR_ENABLED=true
NEXT_PUBLIC_DATA_RETENTION_DAYS=365
NEXT_PUBLIC_PRIVACY_OFFICER_EMAIL=dpo@ciprel.ci

# --- Quiz -------------------------------------------------------------------
NEXT_PUBLIC_QUIZ_ATTEMPTS_LIMIT=3
NEXT_PUBLIC_QUIZ_TIME_LIMIT_MINUTES=30
NEXT_PUBLIC_QUIZ_AUTO_SAVE_INTERVAL=30000

# --- Upload -----------------------------------------------------------------
NEXT_PUBLIC_MAX_VIDEO_SIZE_MB=100
NEXT_PUBLIC_MAX_IMAGE_SIZE_MB=5
NEXT_PUBLIC_ALLOWED_VIDEO_TYPES=video/mp4,video/webm
NEXT_PUBLIC_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- Administration ---------------------------------------------------------
# Secret pour l'endpoint /api/admin/cache (générer : openssl rand -hex 32)
CACHE_ADMIN_SECRET=

# --- Analytics (optionnel) --------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_HOTJAR_ID=

# --- Divers -----------------------------------------------------------------
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
NODE_ENV=production
PORT=3000
